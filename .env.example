# --- Script generation (Anthropic / Claude) ---
# Leave blank to fall back to the offline template generator (no network needed).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Text-to-speech ---
# "offline" (pyttsx3, no key needed) or "elevenlabs" (higher quality, needs the two vars below)
TTS_BACKEND=offline
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Output ---
OUTPUT_DIR=output

# --- Brand defaults ---
CHARACTER_NAME=Bounce
SHOW_NAME=Bounce the Counting Bunny
DEFAULT_AGE_RANGE=2-5
DEFAULT_DURATION_SECONDS=90
